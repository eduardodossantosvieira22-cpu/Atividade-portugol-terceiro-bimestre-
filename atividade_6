programa
{
	
	funcao inicio()
	{
        inteiro numero
        inteiro pares = 0
        inteiro impares = 0

        para (inteiro i = 1; i <= 5; i++)
        {

        	 escreva("digite um número: ")
        	 leia(numero)
            
            se (numero % 2 == 0)
            {
                pares = pares + 1
               
            }
            senao
            {
                impares = impares + 1
                
            }
        }

         escreva("números pares: ", pares, "\n")
        escreva("números ímpares: ", impares)

       
    }
}
